# Postgres connection. For Supabase use the pooled connection (port 6543).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ernt_properties?schema=public"

# Optional: direct connection (port 5432) for migrations. Falls back to DATABASE_URL if unset.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ernt_properties?schema=public"

# Auth.js
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_TRUST_HOST=true

# Public site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
